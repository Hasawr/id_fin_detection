# Example nginx reverse proxy for the OCR API.
# TLS terminates here; uvicorn stays on 127.0.0.1:8010.
# Do NOT proxy Streamlit publicly.
#
# 1. Replace server_name and certificate paths.
# 2. sudo cp deploy/nginx-ocr-api.conf.example /etc/nginx/sites-available/ocr-api
# 3. sudo ln -s /etc/nginx/sites-available/ocr-api /etc/nginx/sites-enabled/
# 4. sudo nginx -t && sudo systemctl reload nginx

upstream ocr_api {
    server 127.0.0.1:8010;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ocr.example.internal;

    ssl_certificate     /etc/ssl/certs/ocr.example.internal.crt;
    ssl_certificate_key /etc/ssl/private/ocr.example.internal.key;

    # Batch uploads can be large (see MAX_BATCH_BYTES).
    client_max_body_size 60m;

    location / {
        proxy_pass http://ocr_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # OCR can take longer on cold start / large batches.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ocr.example.internal;
    return 301 https://$host$request_uri;
}
