# Comma-separated keys accepted in the X-API-Key request header.
API_KEYS=replace-with-a-long-random-key

# Streamlit connects to this FastAPI instance; keep loopback for local use.
OCR_API_BASE_URL=http://127.0.0.1:8000

# OCR runtime configuration.
USE_GPU=true
# Local troubleshooting only. true writes annotated identity images to disk.
SAVE_OCR_DEBUG_IMAGES=false
# Maximum bytes accepted for each uploaded image (10 MiB).
MAX_UPLOAD_BYTES=10485760
# Maximum decoded image area (25 megapixels).
MAX_IMAGE_PIXELS=25000000
# Maximum images accepted by one batch request.
MAX_BATCH_FILES=100
# Maximum aggregate batch size.
MAX_BATCH_BYTES=52428800
# Local audit storage for third-party API traffic (relative to project root).
AUDIT_DB_PATH=data/audit.db
AUDIT_PAYLOAD_DIR=data/audit_payloads
# Metadata/redacted outcomes are always recorded. Raw uploads are opt-in.
AUDIT_STORE_PAYLOADS=false
# Sensitive extracted values stay redacted unless explicitly enabled.
# Enabling this stores real FIN/card serial values in the audit SQLite DB.
AUDIT_STORE_PII=false
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_PAYLOAD_BYTES=1073741824
